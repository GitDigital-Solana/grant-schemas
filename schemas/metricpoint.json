{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MetricPoint",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "repo": { "type": "string" },
    "metric": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "value": { "type": "number" }
  },
  "required": ["id", "repo", "metric", "timestamp", "value"]
}
