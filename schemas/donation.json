{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Donation",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "amount": { "type": "number" },
    "currency": { "type": "string" },
    "donor": { "type": ["string", "null"] },
    "method": { "type": "string" },
    "received_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "amount", "currency", "method", "received_at"]
}
