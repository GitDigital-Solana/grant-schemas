{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Member",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "email": { "type": ["string", "null"] },
    "name": { "type": ["string", "null"] },
    "joined_at": { "type": "string", "format": "date-time" },
    "membership_tier": { "type": ["string", "null"] }
  },
  "required": ["id", "joined_at"]
}
